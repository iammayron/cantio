{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "tmux",
  "preferences": {
    "tmuxSplitPanes": true
  },
  "requireExitConfirmation": true,
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "${CLAUDE_PROJECT_DIR}/.claude/statusline"
  },
  "permissions": {
    "allow": [
      "Bash(xcodebuild:*)",
      "Bash(killall Cantio)",
      "Bash(killall Cantio 2>/dev/null)",
      "Bash(open /Users/mayron/Library/Developer/Xcode/DerivedData/Cantio-*/Build/Products/Debug/Cantio.app)",
      "Bash(open /Users/mayron/projects/mayron/cantio/.build/Build/Products/Debug/Cantio.app)",
      "Bash(swiftformat:*)",
      "Bash(swift-format:*)",
      "Bash(xcrun:*)",
      "Bash(plutil:*)",
      "Bash(defaults read com.mayronalves.cantio*)",
      "Bash(defaults write com.mayronalves.cantio:*)",
      "Bash(defaults delete com.mayronalves.cantio:*)",
      "Bash(log show --predicate process == \"Cantio\" *)",
      "Bash(pgrep -lf Cantio)",
      "Bash(screencapture:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add Cantio*)",
      "Bash(git add CantioTests*)",
      "Bash(git add docs*)",
      "Bash(git add .claude*)",
      "Bash(git add CLAUDE.md)",
      "Bash(git rev-parse:*)",
      "Bash(git branch:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/PostToolUse.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/SessionStart.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/Stop.sh"
          }
        ]
      }
    ]
  }
}
